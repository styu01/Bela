# User-unit TEMPLATE only. Do not enable alongside the old heartbeat.
[Unit]
Description=Marveen weekly stuck-state audit on Monday at 09 Budapest time

[Timer]
OnCalendar=Mon *-*-* 09:00:00 Europe/Budapest
AccuracySec=1min
Persistent=true
Unit=heti-elakadas-audit.service

[Install]
WantedBy=timers.target
